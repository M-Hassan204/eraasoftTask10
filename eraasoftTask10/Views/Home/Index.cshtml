@model eraasoftTask10.ViewModels.HomeFormViewModel

@{
    ViewData["Title"] = "HTML Form Example";
}

<div class="form-page">

    <h1> The Form </h1>

    

    <form asp-controller="Home"
          asp-action="Index"
          method="post">

        <!-- User Information -->
        <fieldset>
            <legend>User Information</legend>

            <div class="form-row">
                <label asp-for="Username">Username:</label>
                <input asp-for="Username" type="text" />
            </div>

            <div class="form-row">
                <label asp-for="Email">Email:</label>
                <input asp-for="Email" type="email" />
            </div>

            <div class="form-row">
                <label asp-for="Password">Password:</label>
                <input asp-for="Password" type="password" />
            </div>
        </fieldset>

        <!-- Contact Information -->
        <fieldset>
            <legend>Contact Information</legend>

            <div class="form-row">
                <label asp-for="Phone">Phone:</label>
                <input asp-for="Phone" type="tel" />
            </div>

            <div class="form-column">
                <label asp-for="Message">Message:</label>
                <textarea asp-for="Message"></textarea>
            </div>
        </fieldset>

        <!-- Subscription -->
        <fieldset>
            <legend>Subscription</legend>

            <div class="checkbox-row">
                <label>
                    <input asp-for="SubscribeNews" />
                    Subscribe to newsletter
                </label>
            </div>

            <div class="checkbox-row">
                <label>
                    <input asp-for="SubscribeOffers" />
                    Subscribe to offers
                </label>
            </div>
        </fieldset>

        <!-- Preferred Language -->
        <fieldset>
            <legend>Preferred Language</legend>

            <div class="form-row">
                <label asp-for="PreferredLanguage">
                    Select your preferred language:
                </label>

                <select asp-for="PreferredLanguage">
                    <option value="English">English</option>
                    <option value="Spanish">Spanish</option>
                    <option value="French">French</option>
                    <option value="German">German</option>
                </select>
            </div>
        </fieldset>

        <!-- Feedback -->
        <fieldset>
            <legend>Feedback</legend>

            <div class="rating-row">
                <label asp-for="Rating">
                    Rate our service:
                </label>

                <input asp-for="Rating"
                       type="range"
                       min="1"
                       max="10"
                       id="ratingSlider" />

                <span id="ratingValue">@Model.Rating</span>
            </div>
        </fieldset>

        <script>
                    const slider = document.getElementById("ratingSlider");
                    const ratingValue = document.getElementById("ratingValue");

                    slider.addEventListener("input", function() {
                        ratingValue.textContent = this.value;
                    });
        </script>

        <div class="buttons">
            <button type="submit">Submit</button>
            <button type="reset">Reset</button>
        </div>

    </form>

</div>