@{
    ViewData["Title"] = "Customers";
}

<div class="container py-5">

    <div class="text-center mb-4">
        <h1>Customers</h1>
        <p class="text-muted">
            Search for a customer by ID
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="mb-3">Find Customer</h4>

            <form asp-controller="Customer"
                  asp-action="Details"
                  method="get"
                  class="d-flex gap-2"
                  style="max-width: 500px;">

                <input type="number"
                       name="id"
                       class="form-control"
                       placeholder="Enter Customer ID"
                       min="1"
                       required />

                <button type="submit"
                        class="btn btn-primary">
                    Find Customer
                </button>

            </form>

        </div>
    </div>

</div>