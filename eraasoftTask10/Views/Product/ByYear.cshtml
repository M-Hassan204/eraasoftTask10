@model IEnumerable<eraasoftTask10.Models.Product>

<h1>Products</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Model Year</th>
            <th>List Price</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.ModelYear</td>
                <td>@product.ListPrice</td>
            </tr>
        }
    </tbody>
</table>