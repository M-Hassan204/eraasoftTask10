@model IEnumerable<eraasoftTask10.ViewModels.ProductBrandViewModel>

<h1>Products and Brands</h1>

<table class="table">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Brand Name</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.BrandName</td>
            </tr>
        }
    </tbody>
</table>