@{
    ViewData["Title"] = "Bike Store Dashboard";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Bike Store Dashboard</h1>
        <p class="text-muted">
            Manage and explore BikeStores data using EF Core & ASP.NET Core MVC
        </p>
    </div>

    <!-- Categories -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3 class="card-title">Categories</h3>
            <p class="text-muted">View all product categories.</p>

            <a asp-controller="Category"
               asp-action="Index"
               class="btn btn-primary">
                View Categories
            </a>
        </div>
    </div>

    <!-- Products -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3 class="card-title">Products</h3>
            <p class="text-muted">All available product operations.</p>

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-primary">
                    All Products
                </a>

                <a asp-controller="Product"
                   asp-action="First"
                   class="btn btn-success">
                    First Product
                </a>

                <form asp-controller="Product"
                      asp-action="Details"
                      method="get"
                      class="d-flex gap-2">

                    <input type="number"
                           name="id"
                           class="form-control"
                           placeholder="Product ID"
                           min="1"
                           required />

                    <button type="submit"
                            class="btn btn-info">
                        Product by ID
                    </button>
                </form>

                <form asp-controller="Product"
                      asp-action="ByYear"
                      method="get"
                      class="d-flex gap-2">

                    <input type="number"
                           name="year"
                           class="form-control"
                           placeholder="Model Year"
                           min="2000"
                           required />

                    <button type="submit"
                            class="btn btn-warning">
                        Products by Year
                    </button>
                </form>

                <a asp-controller="Product"
                   asp-action="ProductsWithBrands"
                   class="btn btn-dark">
                    Products & Brands
                </a>

            </div>
        </div>
    </div>

    <!-- Category Calculations -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3 class="card-title">Category Calculations</h3>
            <p class="text-muted">
                Count products and calculate total prices by category.
            </p>

            <div class="d-flex flex-wrap gap-2">

                <form asp-controller="Product"
                      asp-action="CountByCategory"
                      method="get"
                      class="d-flex gap-2">

                    <input type="number"
                           name="id"
                           class="form-control"
                           placeholder="Category ID"
                           min="1"
                           required />

                    <button type="submit"
                            class="btn btn-secondary">
                        Count Products
                    </button>
                </form>

                <form asp-controller="Product"
                      asp-action="TotalPriceByCategory"
                      method="get"
                      class="d-flex gap-2">

                    <input type="number"
                           name="id"
                           class="form-control"
                           placeholder="Category ID"
                           min="1"
                           required />

                    <button type="submit"
                            class="btn btn-secondary">
                        Total List Price
                    </button>
                </form>

                <a asp-controller="Product"
                   asp-action="AveragePrice"
                   class="btn btn-outline-primary">
                    Average List Price
                </a>

            </div>
        </div>
    </div>

    <!-- Customer -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3 class="card-title">Customer</h3>
            <p class="text-muted">Retrieve a customer by ID.</p>

            <form asp-controller="Customer"
                  asp-action="Details"
                  method="get"
                  class="d-flex gap-2"
                  style="max-width: 400px;">

                <input type="number"
                       name="id"
                       class="form-control"
                       placeholder="Customer ID"
                       min="1"
                       required />

                <button type="submit"
                        class="btn btn-primary">
                    Find Customer
                </button>
            </form>
        </div>
    </div>

    <!-- Orders -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3 class="card-title">Orders</h3>
            <p class="text-muted">Retrieve orders by status.</p>

            <form asp-controller="Order"
                  asp-action="Status"
                  method="post"
                  class="d-flex gap-2"
                  style="max-width: 450px;">

                <select name="status" class="form-select">
                    <option value="1">Pending</option>
                    <option value="2">Processing</option>
                    <option value="3">Rejected</option>
                    <option value="4">Completed</option>
                </select>

                <button type="submit"
                        class="btn btn-success">
                    Search Orders
                </button>
            </form>
        </div>
    </div>

</div>